{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/handler"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/handler"
    }
  ],
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "rewards/night-signal.html"
    }
  },
  "redirects": [
    {
      "source": "/network",
      "destination": "/network/index.html",
      "permanent": false
    }
  ]
}
